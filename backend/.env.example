# Copy this file to .env and fill in your values.
# .env is git-ignored. Never put real keys in this example file.

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed to call the API (CORS). Separate several with commas.
# Include BOTH the landing page and the registration site, e.g. in production:
#   FRONTEND_URL=https://aststraining.com,https://register.aststraining.com
# Locally the landing page runs on localhost:8080 and 127.0.0.1:8080 plays the
# registration site; 4173 is Vite's preview port.
FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4173

# Maximum JSON request body size
BODY_LIMIT=10kb

# Number of proxies in front of the backend (0 locally, 1 on Vercel/most hosts).
# Needed so rate limits see the visitor's real IP.
TRUST_PROXY=0

# ---------------------------------------------------------------------
# Supabase (server-side only; never put these in the landing page)
# Supabase dashboard -> Project Settings -> API
# Leave both empty to use the built-in local development database.
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Admin key for the dashboard and the registration admin endpoints.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty = open access, allowed in development only.
# ---------------------------------------------------------------------
ADMIN_API_KEY=

# ---------------------------------------------------------------------
# Google Sheets (optional). See README "Google Sheets setup".
# The spreadsheet ID is the long part of its URL:
#   https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# ---------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=

# Option A: paste values from the service-account JSON key.
# Keep the quotes, and keep \n where the key has line breaks.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Option B: path to the downloaded JSON key file instead of the two lines above.
# Keep the file OUTSIDE this project folder (or name it google-service-account*.json, which is git-ignored).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Time zone for dates written to Google Sheets
REPORT_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------
# Rate limits per visitor IP
# ---------------------------------------------------------------------
RATE_LIMIT_TRACK_PER_MIN=120
RATE_LIMIT_REGISTRATIONS_PER_10_MIN=10
